	waitmovement 0
	delay 30
	addobject LOCALID_KANTO_PALLET_PROF_OAK
	call_if_eq VAR_TEMP_1, 0, KantoPalletTown_EventScript_OakEnterLeft
	call_if_eq VAR_TEMP_1, 1, KantoPalletTown_EventScript_OakEnterRight
