KantoPalletTown_EventScript_OakRatingScene::
	lockall
	textcolor NPC_TEXT_COLOR_MALE
	setobjectxyperm LOCALID_KANTO_PALLET_PROF_OAK, 14, 14
	setobjectmovementtype LOCALID_KANTO_PALLET_PROF_OAK, MOVEMENT_TYPE_FACE_LEFT
	addobject LOCALID_KANTO_PALLET_PROF_OAK
	applymovement LOCALID_KANTO_PALLET_PROF_OAK, KantoPalletTown_Movement_OakWalkToPlayersDoor
	waitmovement 0
	goto_if_unset FLAG_KANTO_WORLD_MAP_ONE_ISLAND, KantoPalletTown_EventScript_NotBeenToOneIslandYet
	msgbox KantoPalletTown_Text_OakLetMeSeePokedex
	setvar VAR_0x8004, 0
	specialvar VAR_RESULT, KantoGetPokedexCount
	copyvar VAR_0x8008, VAR_0x8005
	copyvar VAR_0x8009, VAR_0x8006
	buffernumberstring STR_VAR_1, VAR_0x8008
	buffernumberstring STR_VAR_2, VAR_0x8009
	goto_if_lt VAR_0x8009, 60, KantoPalletTown_EventScript_NotEnoughMonsForNationalDex
	msgbox KantoPalletTown_Text_CaughtXImpressiveFollowMe
	closemessage
	playbgm MUS_RG_FOLLOW_ME, 0
	applymovement LOCALID_PLAYER, KantoPalletTown_Movement_PlayerWalkToLabFromHouse
	applymovement LOCALID_KANTO_PALLET_PROF_OAK, KantoPalletTown_Movement_OakWalkToLabFromHouse
	waitmovement 0
	opendoor 16, 13
	waitdooranim
	applymovement LOCALID_KANTO_PALLET_PROF_OAK, KantoPalletTown_Movement_OakEnterLab
	applymovement LOCALID_PLAYER, KantoPalletTown_Movement_PlayerEnterLab
	waitmovement 0
	closedoor 16, 13
	waitdooranim
	setvar VAR_KANTO_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB, 7
	setvar VAR_KANTO_MAP_SCENE_PALLET_TOWN_OAK, 3
	setflag FLAG_KANTO_HIDE_OAK_IN_PALLET_TOWN
	warp MAP_KANTO_PALLET_TOWN_PROFESSOR_OAKS_LAB, 6, 12
	waitstate
	releaseall
	end

