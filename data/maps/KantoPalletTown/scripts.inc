KantoPalletTown_EventScript_SignLady::
	lock
	goto_if_eq VAR_KANTO_MAP_SCENE_PALLET_TOWN_SIGN_LADY, 2, KantoPalletTown_EventScript_SignLadyDone
	goto_if_eq VAR_KANTO_MAP_SCENE_PALLET_TOWN_SIGN_LADY, 1, KantoPalletTown_EventScript_SignLadyJustShowedSign
	goto_if_eq SIGN_LADY_READY, TRUE, KantoPalletTown_EventScript_SignLadyStartShowSign
	goto_if_set FLAG_TEMP_2, KantoPalletTown_EventScript_SignLadyGoReadSign
	msgbox KantoPalletTown_Text_HmmIsThatRight
	applymovement LOCALID_KANTO_PALLET_SIGN_LADY, Common_Movement_FacePlayer
	waitmovement 0
	playse SE_PIN
	applymovement LOCALID_KANTO_PALLET_SIGN_LADY, Common_Movement_ExclamationMark
	waitmovement 0
	applymovement LOCALID_KANTO_PALLET_SIGN_LADY, Common_Movement_Delay48
	waitmovement 0
	msgbox KantoPalletTown_Text_OhLookLook
	closemessage
	call_if_eq VAR_FACING, DIR_EAST, KantoPalletTown_EventScript_SignLadyMoveOutOfWayRight
	call_if_ne VAR_FACING, DIR_EAST, KantoPalletTown_EventScript_SignLadyMoveOutOfWayLeft
	copyobjectxytoperm LOCALID_KANTO_PALLET_SIGN_LADY
	setflag FLAG_TEMP_2
	release
	end

