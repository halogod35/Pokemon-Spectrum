	msgbox KantoPalletTown_Text_OakGrassUnsafeNeedMon
	closemessage
	delay 30
	call_if_eq VAR_TEMP_1, 0, KantoPalletTown_EventScript_OakLeadPlayerToLabLeft
	call_if_eq VAR_TEMP_1, 1, KantoPalletTown_EventScript_OakLeadPlayerToLabRight
	opendoor 16, 13
	waitdooranim
	applymovement LOCALID_KANTO_PALLET_PROF_OAK, KantoPalletTown_Movement_OakEnterLab
	applymovement LOCALID_PLAYER, KantoPalletTown_Movement_PlayerEnterLab
	waitmovement 0
	closedoor 16, 13
	waitdooranim
	setvar VAR_KANTO_MAP_SCENE_PALLET_TOWN_PROFESSOR_OAKS_LAB, 1
	clearflag FLAG_KANTO_HIDE_OAK_IN_HIS_LAB
	setvar VAR_KANTO_MAP_SCENE_PALLET_TOWN_OAK, 1
	setflag FLAG_KANTO_HIDE_OAK_IN_PALLET_TOWN
	setflag FLAG_DONT_TRANSITION_MUSIC
	warp MAP_KANTO_PALLET_TOWN_PROFESSOR_OAKS_LAB, 6, 12
	waitstate
	releaseall
	end

