KantoViridianCity_School_EventScript_ChooseBlackboardTopic::
	message KantoViridianCity_School_Text_ReadWhichTopic
	waitmessage
	multichoicegrid 7, 1, MULTI_KANTO_TRAINER_SCHOOL_WHITEBOARD, 3, FALSE
	switch VAR_RESULT
	case 0, KantoViridianCity_School_EventScript_ReadSleep
	case 1, KantoViridianCity_School_EventScript_ReadPoison
	case 2, KantoViridianCity_School_EventScript_ReadParalysis
	case 3, KantoViridianCity_School_EventScript_ReadBurn
	case 4, KantoViridianCity_School_EventScript_ReadFreeze
	case 5, KantoViridianCity_School_EventScript_ExitBlackboard
	case 127, KantoViridianCity_School_EventScript_ExitBlackboard
	end

