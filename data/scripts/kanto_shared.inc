KantoPokedexRating_EventScript_ShowRatingMsg::
	copyvar VAR_0x8004, VAR_0x8009
	special ShowPokedexRatingMessage
	waitmessage
	call_if_eq VAR_RESULT, FALSE, KantoPokedexRating_EventScript_NormalFanfare
	call_if_eq VAR_RESULT, TRUE, KantoPokedexRating_EventScript_DexCompleteFanfare
	waitfanfare
	waitbuttonpress
	return

KantoPokedexRating_EventScript_NormalFanfare::
	playfanfare MUS_RG_DEX_RATING
	return

KantoPokedexRating_EventScript_DexCompleteFanfare::
	playfanfare MUS_EVOLVED
	return

KantoPokedexRating_EventScript_Rate::
	setvar VAR_0x8004, 0
	special KantoStub_Nop
	special KantoStub_Nop
	setvar VAR_0x8004, 0
	specialvar VAR_RESULT, KantoGetPokedexCount
	copyvar VAR_0x8008, VAR_0x8005
	copyvar VAR_0x8009, VAR_0x8006
	copyvar VAR_0x800A, VAR_RESULT
	buffernumberstring STR_VAR_1, VAR_0x8008 @ Num Kanto Seen
	buffernumberstring STR_VAR_2, VAR_0x8009 @ Num Kanto Caught
	msgbox KantoPokedexRating_Text_SeenXOwnedY
	call_if_unset FLAG_KANTO_OAKS_RATING_IS_VIA_PC, KantoPokedexRating_EventScript_SetTextColor
	call KantoPokedexRating_EventScript_ShowRatingMsg
	goto_if_eq VAR_0x800A, FALSE, KantoPokedexRating_EventScript_EndRating  @ National Dex not enabled
	setvar VAR_0x8004, 1
	specialvar VAR_RESULT, KantoGetPokedexCount
	copyvar VAR_0x8008, VAR_0x8005
	copyvar VAR_0x8009, VAR_0x8006
	buffernumberstring STR_VAR_1, VAR_0x8008 @ Num National Seen
	buffernumberstring STR_VAR_2, VAR_0x8009 @ Num National Caught
	msgbox KantoPokedexRating_Text_NationalDexSeenXOwnedY
	specialvar VAR_RESULT, KantoStub_False
	goto_if_eq VAR_RESULT, FALSE, KantoPokedexRating_EventScript_DexIncomplete
	goto_if_eq VAR_RESULT, TRUE, KantoPokedexRating_EventScript_DexComplete
	end

