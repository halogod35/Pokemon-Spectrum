@ --- from pokefirered data/scripts/pkmn_center_nurse.inc ---

KantoEventScript_PkmnCenterNurse::
	goto_if_questlog EventScript_ReleaseEnd
	message KantoText_WelcomeWantToHealPkmn
	waitmessage
	multichoice 19, 8, MULTI_KANTO_YES_NO, FALSE | (TRUE << 1)
	switch VAR_RESULT
	case 0, KantoEventScript_PkmnCenterNurse_HealPkmn
	case 1 KantoEventScript_PkmnCenterNurse_Goodbye
	case MULTI_B_PRESSED, KantoEventScript_PkmnCenterNurse_Goodbye
	end

KantoEventScript_PkmnCenterNurse_HealPkmn::
	incrementgamestat GAME_STAT_USED_POKECENTER
	message KantoText_TakeYourPkmnForFewSeconds
	waitmessage
	call KantoEventScript_PkmnCenterNurse_TakeAndHealPkmn
	special KantoStub_Nop
	goto KantoEventScript_PkmnCenterNurse_CheckTrainerTowerAndUnionRoom
	end

KantoEventScript_PkmnCenterNurse_TakeAndHealPkmn::
	applymovement VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterLeft
	waitmovement 0
	dofieldeffect FLDEFF_POKECENTER_HEAL
	waitfieldeffect FLDEFF_POKECENTER_HEAL
	applymovement VAR_LAST_TALKED, Common_Movement_WalkInPlaceFasterDown
	waitmovement 0
	special HealPlayerParty
	return

KantoEventScript_PkmnCenterNurse_CheckTrainerTowerAndUnionRoom::
	specialvar VAR_RESULT, KantoStub_True
	goto_if_eq VAR_RESULT, FALSE, KantoEventScript_PkmnCenterNurse_ReturnPkmn
	specialvar VAR_RESULT, BufferUnionRoomPlayerName
	copyvar VAR_0x8008, VAR_RESULT
	goto_if_eq VAR_0x8008, 0, KantoEventScript_PkmnCenterNurse_ReturnPkmn
	goto_if_eq VAR_0x8008, 1, KantoEventScript_PkmnCenterNurse_PlayerWaitingInUnionRoom
	end

KantoEventScript_PkmnCenterNurse_ReturnPkmn::
	message KantoText_RestoredPkmnToFullHealth
	waitmessage
	applymovement VAR_LAST_TALKED, KantoMovement_Bow
	waitmovement 0
	msgbox KantoText_WeHopeToSeeYouAgain
	return

KantoEventScript_PkmnCenterNurse_PlayerWaitingInUnionRoom::
	goto_if_set FLAG_KANTO_SYS_INFORMED_OF_LOCAL_WIRELESS_PLAYER, KantoEventScript_PkmnCenterNurse_ReturnPkmn
	msgbox KantoText_RestoredPkmnToFullHealth
	setflag FLAG_KANTO_SYS_INFORMED_OF_LOCAL_WIRELESS_PLAYER
	message KantoText_PlayerIsPlayingRightNowGoForIt
	waitmessage
	applymovement VAR_LAST_TALKED, KantoMovement_Bow
	waitmovement 0
	msgbox KantoText_WeHopeToSeeYouAgain
	return

KantoEventScript_PkmnCenterNurse_Goodbye::
	msgbox KantoText_WeHopeToSeeYouAgain
	return

KantoMovement_Bow::
	nurse_joy_bow
	delay_4
	step_end

