KantoEventScript_DreamEaterTutor::
	lock
	faceplayer
	goto_if_set FLAG_KANTO_TUTOR_DREAM_EATER, KantoEventScript_DreamEaterTaught
	msgbox KantoText_DreamEaterTeach, MSGBOX_YESNO
	goto_if_eq VAR_RESULT, NO, KantoEventScript_DreamEaterDeclined
	call KantoEventScript_CanOnlyBeLearnedOnce
	goto_if_eq VAR_RESULT, NO, KantoEventScript_DreamEaterDeclined
	msgbox KantoText_DreamEaterWhichMon
	setvar VAR_0x8005, TUTOR_MOVE_DREAM_EATER
	call KantoEventScript_ChooseMoveTutorMon
	goto_if_eq VAR_RESULT, FALSE, KantoEventScript_DreamEaterDeclined
	setflag FLAG_KANTO_TUTOR_DREAM_EATER
	goto KantoEventScript_DreamEaterTaught
	end

